---
title: Blog
layout: base.njk
---
<section>
  {%- for post in collections.post | reverse %}
  <article>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <time>{{ post.date | dateDisplay }}</time>
    <p>{{ post.content | striptags | truncate(200) }}</p>
  </article>
  {%- endfor %}
</section>
